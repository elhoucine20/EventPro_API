
// notification par email using brevo
def notifier(String statut) {
    try {
        emailext(
            from: env.MAIL_FROM,
            to: env.NOTIFY_EMAIL,
            subject: "[EventPro] Build #${env.BUILD_NUMBER} : ${statut}",
            mimeType: 'text/html',
            body: """
                <h3>EventPro - build #${env.BUILD_NUMBER} : ${statut}</h3>
                <ul>
                  <li>Version : ${env.IMAGE_TAG ?: 'image non construite'}</li>
                  <li>Commit : ${env.GIT_COMMIT ? env.GIT_COMMIT.take(7) : 'inconnu'}</li>
                  <li>Détails : <a href="${env.BUILD_URL}">${env.BUILD_URL}</a></li>
                </ul>
            """
        )
    } catch (err) {
        echo "Notification impossible : ${err.message}"
    }
}


// pepline est une ensemble des instrections pour jenkins, que gerer les étapes apres le changement de code a github
pipeline {
    agent any  // any agent ,selon mon machine

    //
    environment {
        IMAGE_NAME = 'eventpro-api'
        REGISTRY   = 'localhost:5000'
    }

    options { // les champs que pas necessires mais bon pratique
        timestamps() // time pour voir warning ou error derictement dans jenkins
        timeout(time: 20, unit: 'MINUTES') //  ne deppass pas 20 a build
        disableConcurrentBuilds()  // if un build lancer attendu
        buildDiscarder(logRotator(numToKeepStr: '20'))  // historique de build maximun 20
    }

    triggers { // listener
        pollSCM('H/2 * * * *') // chaque 2 min listener sur github if un changement build
    }

    stages { // relation avec l'app, (layyers)
        stage('Checkout') { //  Checkout => layyern que recupere la version final de code
            steps {
                checkout scm
                sh 'git log -1 --pretty="%h %s"'
            }
        }

        stage('Build') { // layyer que build par maven
            steps {
                sh 'chmod +x mvnw'  //
                sh './mvnw -B -ntp clean compile' //
            }
        }

        stage('Tests') {  // run tests unitaires
            steps {
                sh './mvnw -B -ntp test'
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml' // tout les tests de l'application
                }
            }
        }


        // SonarQuebe
        stage('Analyse SonarQube') {
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh './mvnw -B -ntp org.sonarsource.scanner.maven:sonar-maven-plugin:sonar'
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // dockerlisation 4 stages
        stage('Packaging') {
            steps {
                sh './mvnw -B -ntp -DskipTests package'
            }
            post {
                success {
                    archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
                }
            }
        }

        stage('Image Docker') {
            steps {
                script {
                    env.APP_VERSION = sh(
                        script: './mvnw -q -B help:evaluate -Dexpression=project.version -DforceStdout',
                        returnStdout: true).trim()
                    env.GIT_SHORT = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    env.IMAGE_TAG = "${env.APP_VERSION}-${env.BUILD_NUMBER}"
                    currentBuild.description = "${env.IMAGE_TAG} (${env.GIT_SHORT})"
                }
                sh '''
                    docker build \
                      --label org.opencontainers.image.version="$APP_VERSION" \
                      --label org.opencontainers.image.revision="$GIT_SHORT" \
                      --label ci.build.number="$BUILD_NUMBER" \
                      -t "$REGISTRY/$IMAGE_NAME:$IMAGE_TAG" \
                      -t "$REGISTRY/$IMAGE_NAME:$GIT_SHORT" .
                '''
            }
        }

        stage('Smoke test') {
            steps {
                sh 'bash ci_cd/smoke-test.sh "$REGISTRY/$IMAGE_NAME:$IMAGE_TAG"'
            }
        }

        stage('Publication') {
            when {
                expression { env.GIT_BRANCH in ['origin/main', 'origin/master'] }
            }
            steps {
                sh '''
                    docker tag "$REGISTRY/$IMAGE_NAME:$IMAGE_TAG" "$REGISTRY/$IMAGE_NAME:latest"
                    docker push "$REGISTRY/$IMAGE_NAME:$IMAGE_TAG"
                    docker push "$REGISTRY/$IMAGE_NAME:$GIT_SHORT"
                    docker push "$REGISTRY/$IMAGE_NAME:latest"
                '''
            }
        }




    }

  /*  post {
        // dockerlisation
        always { sh 'docker image prune -f || true' }

        success {
           echo 'Pipeline OK'
        }
        failure {
           echo 'Pipeline en échec : consulter les logs ci-dessus'
        }
    }
    */

    post {
            always   { sh 'docker image prune -f || true' }
            success  { script { notifier('RÉUSSI') } }
            failure  { script { notifier('ÉCHEC') } }
            unstable { script { notifier('INSTABLE') } }
        }

}
